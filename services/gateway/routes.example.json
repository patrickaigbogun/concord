{
  "services": [
    {
      "service_id": "id",
      "prefixes": ["/oauth/", "/.well-known/", "/api/v1/auth/", "/api/v1/oauth/"],
      "target_url": "https://id.dexx.systems",
      "auth_mode": "public",
      "rate_limit_rpm": 60,
      "health_path": "/health"
    },
    {
      "service_id": "chat",
      "prefixes": ["/api/", "/socket/", "/swagger", "/openapi.json"],
      "target_url": "https://chat.concord.dexx.systems",
      "auth_mode": "optional",
      "rate_limit_rpm": 180,
      "health_path": "/api/openapi.json"
    }
  ]
}
